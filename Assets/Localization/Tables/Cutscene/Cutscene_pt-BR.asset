  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Cutscene_pt-BR
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: pt-BR
  m_SharedData: {fileID: 11400000, guid: 30e590581f804cb40b6091dac4b279e6, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 38846238720
    m_Localized: "Há décadas, não conseguimos mais sobreviver na superfície.\nEntão, vivemos agora em armazéns subterrâneos."
    m_Metadata:
      m_Items: []
  - m_Id: 66927104000
    m_Localized: "Parece que... paramos no tempo. Não sei explicar.\nA comida está escassa, mas não me importo de comer um churrasco de rato de vez em quando."
    m_Metadata:
      m_Items: []
  - m_Id: 99638480896
    m_Localized: Não temos notícias do pessoal dos outros armazéns há dias.
    m_Metadata:
      m_Items: []
  - m_Id: 124955299840
    m_Localized: "Não posso mais ficar aqui.\nPreciso seguir os trilhos e sair deste lugar."
    m_Metadata:
      m_Items: []
  - m_Id: 150704132096
    m_Localized: Vamos colocar uma música...
    m_Metadata:
      m_Items: []
  - m_Id: 177870639104
    m_Localized: ...e ver quanto tempo vou durar lá fora.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
