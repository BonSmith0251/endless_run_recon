  m_SharedData: {fileID: 11400000, guid: 30e590581f804cb40b6091dac4b279e6, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 38846238720
    m_Localized: "Powierzchnię straciliśmy dziesiątki lat temu.\nWycofaliśmy się pod ziemię. Do silosów."
    m_Metadata:
      m_Items: []
  - m_Id: 66927104000
    m_Localized: "Czas jakby... stanął? Trudno powiedzieć.\nKończą się racje żywnościowe. Szczurom chyba nic nie brakuje."
    m_Metadata:
      m_Items: []
  - m_Id: 99638480896
    m_Localized: Od kilku dni żadnych wieści z pozostałych silosów.
    m_Metadata:
      m_Items: []
  - m_Id: 124955299840
    m_Localized: "Nie mogę tu zostać.\nTory mogą być moją jedyną drogą ucieczki."
    m_Metadata:
      m_Items: []
  - m_Id: 150704132096
    m_Localized: Czas włączyć muzykę...
    m_Metadata:
      m_Items: []
  - m_Id: 177870639104
    m_Localized: ...i sprawdzić, jak długo wytrzymam tam na zewnątrz.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
