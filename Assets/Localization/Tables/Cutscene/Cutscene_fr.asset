  m_SharedData: {fileID: 11400000, guid: 30e590581f804cb40b6091dac4b279e6, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 38846238720
    m_Localized: "On a perdu la surface il y a\ndes décennies. On s'est réfugiés sous le sol. Dans les silos."
    m_Metadata:
      m_Items: []
  - m_Id: 66927104000
    m_Localized: "Le temps semble s'être... arrêté ? Je sais pas vraiment.\nLes rations s'amenuisent. Par contre, les rats le vivent bien."
    m_Metadata:
      m_Items: []
  - m_Id: 99638480896
    m_Localized: Ça fait des jours qu'on n'a plus de nouvelles des autres silos.
    m_Metadata:
      m_Items: []
  - m_Id: 124955299840
    m_Localized: "Je peux pas rester là.\nLes rails sont ma seule issue."
    m_Metadata:
      m_Items: []
  - m_Id: 150704132096
    m_Localized: Allez, on lance la musique...
    m_Metadata:
      m_Items: []
  - m_Id: 177870639104
    m_Localized: ...et on verra combien de temps je tiens, dehors.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
