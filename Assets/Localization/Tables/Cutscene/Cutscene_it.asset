  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Cutscene_it
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: it
  m_SharedData: {fileID: 11400000, guid: 30e590581f804cb40b6091dac4b279e6, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 38846238720
    m_Localized: "Abbiamo perso e abbandonato la superficie\ndecenni fa. Ci siamo ritirati sottoterra. Nei silos."
    m_Metadata:
      m_Items: []
  - m_Id: 66927104000
    m_Localized: "Il tempo sembra... essersi fermato? Non ne sono sicuro.\nLe razioni stanno scarseggiando. I topi però sembrano in perfetta forma."
    m_Metadata:
      m_Items: []
  - m_Id: 99638480896
    m_Localized: Nessuna notizia dagli altri silos da giorni ormai.
    m_Metadata:
      m_Items: []
  - m_Id: 124955299840
    m_Localized: "Non posso rimanere qui.\nLe rotaie potrebbero essere la mia unica via d'uscita."
    m_Metadata:
      m_Items: []
  - m_Id: 150704132096
    m_Localized: È ora di mettere un po' di musica...
    m_Metadata:
      m_Items: []
  - m_Id: 177870639104
    m_Localized: ...e vedere quanto resisterò là fuori.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
