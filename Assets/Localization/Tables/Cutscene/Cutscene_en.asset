  m_TableData:
  - m_Id: 38846238720
    m_Localized: We lost the surface decades ago. Retreated underground. Into the silos.
    m_Metadata:
      m_Items: []
  - m_Id: 66927104000
    m_Localized: "Time seemingly... Stopped? I’m not sure.\nRations are running low. Rats seem fine though."
    m_Metadata:
      m_Items: []
  - m_Id: 99638480896
    m_Localized: No news from the other silos for days now.
    m_Metadata:
      m_Items: []
  - m_Id: 124955299840
    m_Localized: "I cannot stay here.\nThe rails might be my only way out."
    m_Metadata:
      m_Items: []
  - m_Id: 150704132096
    m_Localized: Time to put on some music...
    m_Metadata:
      m_Items: []
  - m_Id: 177870639104
    m_Localized: ...and see how long I’ll last out there.
    m_Metadata:
      m_Items: []
  references:
    version: 2
