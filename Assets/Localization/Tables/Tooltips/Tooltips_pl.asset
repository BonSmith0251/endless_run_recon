  m_TableData:
  - m_Id: 117963395072
    m_Localized: Wybierz wagon z <color=#FFEB87>tego samego poziomu</color> aby rozpocząć łączenie. Anuluj za pomocą.
    m_Metadata:
      m_Items: []
  - m_Id: 515176566784
    m_Localized: Kliknij wagon, aby go wybrać.
    m_Metadata:
      m_Items: []
  - m_Id: 695485501440
    m_Localized: Użyj
    m_Metadata:
      m_Items: []
  - m_Id: 757099827200
    m_Localized: 'Przełączaj się między wagonami za pomocą:'
    m_Metadata:
      m_Items: []
  - m_Id: 882278830080
    m_Localized: 'Zmieniaj kolejność wagonów za pomocą:'
    m_Metadata:
      m_Items: []
  - m_Id: 951728115712
    m_Localized: Przeciągnij i upuść wagony, aby zmienić ich kolejność.
    m_Metadata:
      m_Items: []
  - m_Id: 254346871345152
    m_Localized: Twój postęp w bieżącym podejściu zostanie utracony.
    m_Metadata:
      m_Items: []
  - m_Id: 1357094152998912
    m_Localized: Przeciągnij za pomocą
    m_Metadata:
      m_Items: []
  - m_Id: 7511486510043136
    m_Localized: Wybrany wagon zostanie usunięty\npo odebraniu nagrody.
    m_Metadata:
      m_Items: []
  - m_Id: 10494826276098048
    m_Localized: Wszystkie ulepszenia i monety metaprogresji zostaną utracone.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
