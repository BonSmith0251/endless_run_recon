  m_TableData:
  - m_Id: 117963395072
    m_Localized: 'Válassz egy <color=#FFEB87>azonos szintű</color> vagont az összevonás megkezdéséhez. Visszavonás:'
    m_Metadata:
      m_Items: []
  - m_Id: 515176566784
    m_Localized: Klikkelj egy vagonra a kiválasztáshoz.
    m_Metadata:
      m_Items: []
  - m_Id: 695485501440
    m_Localized: Nyomd
    m_Metadata:
      m_Items: []
  - m_Id: 757099827200
    m_Localized: 'Vagonok közötti váltás:'
    m_Metadata:
      m_Items: []
  - m_Id: 882278830080
    m_Localized: 'Vagonok átrendezése:'
    m_Metadata:
      m_Items: []
  - m_Id: 951728115712
    m_Localized: Klikkelj és húzd a vagonokat az átrendezéshez.
    m_Metadata:
      m_Items: []
  - m_Id: 254346871345152
    m_Localized: A mostani menetben gyűjtött cuccaid elvesznek.
    m_Metadata:
      m_Items: []
  - m_Id: 1357094152998912
    m_Localized: Húzd
    m_Metadata:
      m_Items: []
  - m_Id: 10494826276098048
    m_Localized: Minden fejlesztés és gyűjtött érme elvész.
    m_Metadata:
      m_Items: []
  references:
    version: 2
