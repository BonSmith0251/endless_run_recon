  m_TableData:
  - m_Id: 117963395072
    m_Localized: Selecciona un vagón de la <color=#FFEB87>misma categoría</color> para iniciar la fusión. Cancela con
    m_Metadata:
      m_Items: []
  - m_Id: 515176566784
    m_Localized: Haz clic en un vagón para seleccionarlo.
    m_Metadata:
      m_Items: []
  - m_Id: 695485501440
    m_Localized: Usa
    m_Metadata:
      m_Items: []
  - m_Id: 757099827200
    m_Localized: 'Cambia entre vagones con:'
    m_Metadata:
      m_Items: []
  - m_Id: 882278830080
    m_Localized: 'Reordena los vagones con:'
    m_Metadata:
      m_Items: []
  - m_Id: 951728115712
    m_Localized: Arrastra y suelta los vagones para reordenarlos.
    m_Metadata:
      m_Items: []
  - m_Id: 254346871345152
    m_Localized: Se perderá el progreso de la partida actual.
    m_Metadata:
      m_Items: []
  - m_Id: 1357094152998912
    m_Localized: Arrastra con
    m_Metadata:
      m_Items: []
  - m_Id: 7511486510043136
    m_Localized: El vagón seleccionado se eliminará\ntras haber elegido una recompensa.
    m_Metadata:
      m_Items: []
  - m_Id: 10494826276098048
    m_Localized: Se perderán todas las mejoras y las metamonedas.
    m_Metadata:
      m_Items: []
