  m_TableData:
  - m_Id: 117963395072
    m_Localized: '<color=#FFEB87>同じティア</color>の車両を選択し、合体を開始する。キャンセル：'
    m_Metadata:
      m_Items: []
  - m_Id: 515176566784
    m_Localized: 車両をクリックし、選択してください。
    m_Metadata:
      m_Items: []
  - m_Id: 695485501440
    m_Localized: 使用
    m_Metadata:
      m_Items: []
  - m_Id: 757099827200
    m_Localized: 車両切り替え：
    m_Metadata:
      m_Items: []
  - m_Id: 882278830080
    m_Localized: 車両順番変更：
    m_Metadata:
      m_Items: []
  - m_Id: 951728115712
    m_Localized: 車両をドラッグ＆ドロップして並べ替えます。
    m_Metadata:
      m_Items: []
  - m_Id: 254346871345152
    m_Localized: 現在のプレイの進行状況は失われます。
    m_Metadata:
      m_Items: []
  - m_Id: 1357094152998912
    m_Localized: ドラッグ：
    m_Metadata:
      m_Items: []
  - m_Id: 7511486510043136
    m_Localized: 報酬を選択すると、\n選んだ車両は削除されます。
    m_Metadata:
      m_Items: []
  - m_Id: 10494826276098048
    m_Localized: すべてのアップグレードとメタコインは失われます。
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
