  m_TableData:
  - m_Id: 117963395072
    m_Localized: Seleziona un vagone dello <color=#FFEB87>stesso grado</color> per avviare l'unione. Annulla con
    m_Metadata:
      m_Items: []
  - m_Id: 515176566784
    m_Localized: Clicca su un vagone per selezionarlo.
    m_Metadata:
      m_Items: []
  - m_Id: 695485501440
    m_Localized: Usa
    m_Metadata:
      m_Items: []
  - m_Id: 757099827200
    m_Localized: 'Passa da un vagone all''altro con:'
    m_Metadata:
      m_Items: []
  - m_Id: 882278830080
    m_Localized: 'Riordina i vagoni con:'
    m_Metadata:
      m_Items: []
  - m_Id: 951728115712
    m_Localized: Trascina e rilascia i vagoni per riposizionarli.
    m_Metadata:
      m_Items: []
  - m_Id: 254346871345152
    m_Localized: I progressi della partita in corso andranno persi.
    m_Metadata:
      m_Items: []
  - m_Id: 1357094152998912
    m_Localized: Trascina con
    m_Metadata:
      m_Items: []
  - m_Id: 7511486510043136
    m_Localized: Il vagone selezionato verrà rimosso dopo\naver scelto una ricompensa.
    m_Metadata:
      m_Items: []
  - m_Id: 10494826276098048
    m_Localized: Tutti i potenziamenti e le monete meta andranno persi.
    m_Metadata:
      m_Items: []
  references:
