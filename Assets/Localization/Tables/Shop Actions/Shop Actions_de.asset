    m_Localized: Waggon hinzufügen
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: Fügt dem Zug einen neuen gewöhnlichen Waggon hinzu.
    m_Metadata:
      m_Items: []
