  m_TableData:
  - m_Id: 1
    m_Localized: Połącz wagony
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: Łącz wagony tego samego poziomu, aby zwiększyć liczbę gniazd na moduły i zyskać potężne bonusy.\n<color=#FFEB87>Połączenie nie następuje natychmiast.</color> Licznik pokazuje, ile stacji wagony muszą przetrwać, aby naprawdę się połączyć.
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: Dodaj wagon
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: Dodaj nowy zwykły wagon do pociągu.
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: Napraw pociąg
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: Napraw pociąg.
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: Odśwież sklep
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: Odśwież ofertę sklepu. Cena odświeżenia rośnie z każdym kolejnym użyciem.
    m_Metadata:
      m_Items: []
  - m_Id: 20629577020379136
    m_Localized: Kupiono
    m_Metadata:
      m_Items: []
