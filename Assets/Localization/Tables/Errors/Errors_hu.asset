  m_TableData:
  - m_Id: 1
    m_Localized: A vonat életereje a maximumon van.
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: Nincs több vagon az állomáson.
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: Nem lehet több vagont adni a vonathoz.
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: A vagont nem lehet összevonni.
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: Gyűjts több érmét!
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: Nincs szabad foglalat.
    m_Metadata:
      m_Items: []
  - m_Id: 3172712879656960
    m_Localized: Az utolsó drón nem adható el.
