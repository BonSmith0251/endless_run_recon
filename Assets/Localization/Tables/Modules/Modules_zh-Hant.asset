  m_TableData:
  - m_Id: 68
    m_Localized: '{target}的<color=#FFEB87>{stat}</color> {value}。'
    m_Metadata:
      m_Items:
      - rid: 4150802888256127272
  - m_Id: 69
    m_Localized: '<color=#FFEB87>{stat}</color> {value}。'
    m_Metadata:
      m_Items:
      - rid: 4150802888256127272
  - m_Id: 70
    m_Localized: 為{target}添加{effect}。
    m_Metadata:
      m_Items:
      - rid: 4150802888256127272
  - m_Id: 1
    m_Localized: 火焰噴射器
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: 噴射火焰並造成持續傷害。
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: 病毒
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: 危險廢料
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: 鋸齒
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: 對這節車廂周圍的敵人造成傷害。
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: 衝鋒槍無人機
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: 衝鋒槍無人機攻速快、射程中，但傷害低。
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: 閃電武器
    m_Metadata:
      m_Items: []
  - m_Id: 12
    m_Localized: 隨機攻擊數名遠距離敵人。並連鎖攻擊其附近敵人。
    m_Metadata:
      m_Items: []
  - m_Id: 13
    m_Localized: 水晶
    m_Metadata:
      m_Items: []
  - m_Id: 15
    m_Localized: 火焰配件
    m_Metadata:
      m_Items: []
  - m_Id: 17
    m_Localized: 鈾
    m_Metadata:
      m_Items: []
  - m_Id: 19
    m_Localized: 金條
    m_Metadata:
      m_Items: []
  - m_Id: 20
    m_Localized: 每到一站，此模組<color=#FFEB87>售價</color>提升 <color=#71FF90>{0}</color>。
    m_Metadata:
      m_Items: []
  - m_Id: 21
    m_Localized: 寒冰噴射器
    m_Metadata:
      m_Items: []
  - m_Id: 22
    m_Localized: 噴射冷氣，降低敵人移動速度。
    m_Metadata:
      m_Items: []
  - m_Id: 23
    m_Localized: 寒冰配件
    m_Metadata:
      m_Items: []
  - m_Id: 25
    m_Localized: 霰彈槍無人機
    m_Metadata:
      m_Items: []
  - m_Id: 26
    m_Localized: 霰彈槍無人機近距離傷害高、攻擊範圍廣，但攻速低。
    m_Metadata:
      m_Items: []
  - m_Id: 27
    m_Localized: 擊退配件
    m_Metadata:
      m_Items: []
  - m_Id: 29
    m_Localized: 霰彈槍砲塔
    m_Metadata:
      m_Items: []
  - m_Id: 30
    m_Localized: 在這節車廂安裝一把霰彈槍。
    m_Metadata:
      m_Items: []
  - m_Id: 31
    m_Localized: 一袋金幣
    m_Metadata:
      m_Items: []
  - m_Id: 32
    m_Localized: 將其運送至下一站，並獲得 300 金幣。
    m_Metadata:
      m_Items: []
  - m_Id: 33
    m_Localized: 雷達
    m_Metadata:
      m_Items: []
  - m_Id: 35
    m_Localized: 步槍砲塔
    m_Metadata:
      m_Items: []
  - m_Id: 36
    m_Localized: 在這節車廂安裝一把步槍。
    m_Metadata:
      m_Items: []
  - m_Id: 37
    m_Localized: 雷射砲塔
    m_Metadata:
      m_Items: []
  - m_Id: 38
    m_Localized: 在這節車廂安裝一把能造成大量傷害的雷射武器。
    m_Metadata:
      m_Items: []
  - m_Id: 39
    m_Localized: 鈽
    m_Metadata:
      m_Items: []
  - m_Id: 41
    m_Localized: 穿刺器
    m_Metadata:
      m_Items: []
  - m_Id: 43
    m_Localized: 快速合併
    m_Metadata:
      m_Items: []
  - m_Id: 44
    m_Localized: 運送至下一戰後，合併這節車廂所需波次 <color=#71FF90>-1</color>。（最低為 1）
    m_Metadata:
      m_Items: []
  - m_Id: 45
    m_Localized: 吉他音箱
    m_Metadata:
      m_Items: []
  - m_Id: 46
    m_Localized: 在列車受到攻擊時，將敵人擊退。
    m_Metadata:
      m_Items: []
  - m_Id: 47
    m_Localized: 收集箱
    m_Metadata:
      m_Items: []
  - m_Id: 49
    m_Localized: 衝鋒槍砲塔
    m_Metadata:
      m_Items: []
  - m_Id: 50
    m_Localized: 在這節車廂安裝一把衝鋒槍。
    m_Metadata:
      m_Items: []
  - m_Id: 51
    m_Localized: 氧氣瓶
    m_Metadata:
      m_Items: []
  - m_Id: 53
    m_Localized: 失落方舟
    m_Metadata:
      m_Items: []
  - m_Id: 54
    m_Localized: 這節車廂及其相鄰車廂的<color=#FFEB87>所有屬性</color>提升 <color=#71FF90>50%</color>。到達下一站後移除。
    m_Metadata:
      m_Items: []
  - m_Id: 55
    m_Localized: 步槍無人機
    m_Metadata:
      m_Items: []
  - m_Id: 56
    m_Localized: 步槍無人機傷害高、射程遠，但攻速低。
