    m_Localized: Odpady niebezpieczne
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: Piła tarczowa
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: Zadaje obrażenia wokół tego wagonu.
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: Dron SMG
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: Dron SMG o dużej szybkostrzelności, zadający niewielkie obrażenia na średnim dystansie.
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: Broń błyskawicowa
    m_Metadata:
      m_Items: []
  - m_Id: 12
    m_Localized: Atakuje losowych wrogów z dużej odległości. Wyładowanie przeskakuje na pobliskich przeciwników.
    m_Metadata:
      m_Items: []
  - m_Id: 13
    m_Localized: Kryształ
    m_Metadata:
      m_Items: []
  - m_Id: 15
    m_Localized: Modyfikator ognia
    m_Metadata:
      m_Items: []
  - m_Id: 17
    m_Localized: Uran
    m_Metadata:
      m_Items: []
  - m_Id: 19
    m_Localized: Sztabki złota
    m_Metadata:
      m_Items: []
  - m_Id: 20
    m_Localized: Wartość <color=#FFEB87>sprzedaży</color> tego modułu wzrasta o <color=#71FF90>{0}</color> na każdej stacji.
    m_Metadata:
      m_Items:
      - rid: -2
  - m_Id: 21
    m_Localized: Zamrażarka
    m_Metadata:
      m_Items: []
  - m_Id: 22
    m_Localized: Wystrzeliwuje lód i spowalnia wrogów.
