    m_Metadata:
      m_Items: []
  - m_Id: 26
    m_Localized: Dron ze strzelbą zadający duże obrażenia na bliskim dystansie. Ma szeroki rozrzut i niską szybkostrzelność.
    m_Metadata:
      m_Items: []
  - m_Id: 27
    m_Localized: Modyfikator odrzutu
    m_Metadata:
      m_Items: []
