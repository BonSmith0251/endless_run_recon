  m_TableData:
  - m_Id: 1
    m_Localized: Miotacz ognia
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: Wystrzeliwuje płomienie i zadaje obrażenia w czasie.
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: Wirus
    m_Metadata:
      m_Items: []
