    m_Metadata:
      m_Items: []
  - m_Id: 49
    m_Localized: 冲锋枪炮塔
    m_Metadata:
      m_Items: []
  - m_Id: 50
    m_Localized: 在这节车厢安装一把冲锋枪。
    m_Metadata:
      m_Items: []
  - m_Id: 51
    m_Localized: 氧气瓶
    m_Metadata:
