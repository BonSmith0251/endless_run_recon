      m_Items: []
  - m_Id: 11
    m_Localized: Arma elettrica
    m_Metadata:
      m_Items: []
  - m_Id: 12
    m_Localized: Prende di mira nemici casuali a lunga distanza. Propaga le scariche ai nemici vicini.
