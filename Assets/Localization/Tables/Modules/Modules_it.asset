    m_Localized: Lama circolare
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: Infligge danni ad area circolare attorno a questo vagone.
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: Drone SMG
    m_Metadata:
      m_Items: []
