    m_Localized: Sägeblatt
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: Verursacht Schaden im Umkreis dieses Waggons.
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: MP-Drohne
    m_Metadata:
      m_Items: []
