      m_Items: []
  - m_Id: 11
    m_Localized: Blitzwaffe
    m_Metadata:
      m_Items: []
  - m_Id: 12
    m_Localized: Zielt auf zufällige Gegner in großer Reichweite. Springt auf Gegner in der Nähe über.
