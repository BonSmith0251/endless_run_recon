    m_Metadata:
      m_Items: []
  - m_Id: 19
    m_Localized: Aranyrudak
    m_Metadata:
      m_Items: []
  - m_Id: 20
    m_Localized: A modul <color=#FFEB87>eladási értéke</color> <color=#71FF90>{0}</color> egységgel nő minden állomáson.
