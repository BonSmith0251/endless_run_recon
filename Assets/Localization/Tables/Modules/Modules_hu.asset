  - m_Id: 1
    m_Localized: Lángszóró
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: Lángokat szór és folyamatosan sebez.
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: Vírus
