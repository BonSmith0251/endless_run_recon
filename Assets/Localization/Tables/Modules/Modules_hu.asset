    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: Penge
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: Kering a vagon körül és nagyot sebez.
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: SMG drón
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: SMG drón, amely alacsony sebzésű, de gyorsan lő közepes távolságra.
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: Villámcsapás
    m_Metadata:
      m_Items: []
  - m_Id: 12
    m_Localized: Távoli ellenségeket céloz véletlenszerűen. A közeli ellenségekre is átterjed.
    m_Metadata:
      m_Items: []
  - m_Id: 13
    m_Localized: Kristály
    m_Metadata:
      m_Items: []
  - m_Id: 15
